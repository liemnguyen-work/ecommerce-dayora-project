generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum Scenario {
  PICNIC
  DATE
  BEACH
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  EXPIRED
}

enum ShippingStatus {
  NOT_SHIPPED
  PREPARING
  SHIPPING
  DELIVERED
  RETURNED
}

enum RuleSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
