{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma --allow-no-models",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
