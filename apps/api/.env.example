# Copy thành apps/api/.env rồi điền giá trị thật.
# KHÔNG commit file .env.
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Sinh riêng trên mỗi môi trường theo docs/SETUP.md
JWT_SECRET=<generate-locally>

# Supabase > Project Settings > Database > Connection string
# Hỏi PM Liêm để lấy thông tin kết nối.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# VNPay Sandbox
# Đăng ký tài khoản thử nghiệm tại https://sandbox.vnpayment.vn/devreg/
VNP_TMN_CODE=<tmn-code>
VNP_HASH_SECRET=<hash-secret>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua

# Chỉ điền trong môi trường thử riêng khi cần seed admin và RuleSet
SEED_ADMIN_EMAIL=<local-admin-email>
SEED_ADMIN_PASSWORD=<local-admin-password>
